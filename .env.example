APP_NAME=Fleetlog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8080
APP_URL=http://localhost:8080
FORCE_HTTPS=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos (en Docker usa DB_HOST=db; en local sin Docker usa 127.0.0.1 o sqlite)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fleetlog_system
DB_USERNAME=fleetlog
DB_PASSWORD=fleetlog_secret
DB_ROOT_PASSWORD=fleetlog_root_secret
DB_FORWARD_PORT=3309

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS para apps móviles (Flutter/Capacitor) y Vite remoto
CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false

# Sembrar usuario admin@fleetlog.test / motorista@fleetlog.test automáticamente al iniciar Docker
AUTO_SEED=true

# Modo Híbrido desde esta PC (npm run dev:remote):
# Apunta al servidor Linux donde corre Docker/API (ej: http://192.168.1.50:8080 o https://fleetlog.tudominio.com)
VITE_API_TARGET=http://localhost:8080
VITE_APP_NAME="${APP_NAME}"
